generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model BankCard {
  id            Int      @id @default(autoincrement())
  country       String
  firstName     String
  lastName      String
  cardNumber    String
  expiryDate    DateTime
  cvc           String
  userId        String      @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

}

model Profile {
  id               Int      @id @default(autoincrement())
  name             String
  about            String
  avatarImage      String
  socialMediaURL   String
  successMessage   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             String
}

model Donation {
  id                         Int      @id @default(autoincrement())
  amount                     Int
  specialMessage             String
  socialURLOrBuyMeACoffee    String
  // donor                      User     @relation("UserDonor", fields: [donorId], references: [id])
  donorId                    Int
  recipient                  String
  recipientId                Int
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}
